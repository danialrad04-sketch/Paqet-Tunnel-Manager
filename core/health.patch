@@ -0,0 +1,52 @@
+package health
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"paqet/internal/protocol"
+)
+
+func TestExchange(t *testing.T) {
+	for _, scenario := range []struct {
+		name    string
+		reply   bool
+		healthy bool
+		failure string
+	}{
+		{name: "pong", reply: true, healthy: true},
+		{name: "unexpected", reply: true, failure: "unexpected_response"},
+		{name: "silence", failure: "timeout"},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			client, peer := net.Pipe()
+			defer client.Close()
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				defer peer.Close()
+				var request protocol.Proto
+				if err := request.Read(peer); err != nil {
+					return
+				}
+				if !scenario.reply {
+					var ignored [1]byte
+					_, _ = peer.Read(ignored[:])
+					return
+				}
+				response := protocol.Proto{Type: protocol.PPING}
+				if scenario.healthy {
+					response.Type = protocol.PPONG
+				}
+				_ = response.Write(peer)
+			}()
+			result := exchange(client, 100*time.Millisecond)
+			_ = client.Close()
+			<-done
+			if result.OK != scenario.healthy || result.Failure != scenario.failure {
+				t.Errorf("exchange returned %+v", result)
+			}
+		})
+	}
+}
